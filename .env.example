# Domestic Razorpay merchant only. Never put the FCRA credentials in these variables.
RAZORPAY_DOMESTIC_KEY_ID=rzp_live_TezfswPfz9JcMi
RAZORPAY_DOMESTIC_KEY_SECRET=

# Create this secret in Razorpay when the deployed webhook URL is available.
RAZORPAY_DOMESTIC_WEBHOOK_SECRET=

# Optional: caps a recurring instruction. Donors can still cancel earlier.
RAZORPAY_SUBSCRIPTION_MONTHLY_CYCLES=120
RAZORPAY_SUBSCRIPTION_YEARLY_CYCLES=10

# International/FCRA PayPal merchant only. Use sandbox until the FCRA settlement
# routing and PayPal account review are confirmed, then change to live.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_FCRA_CLIENT_ID=
PAYPAL_FCRA_CLIENT_SECRET=
