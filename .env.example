# Domestic Razorpay merchant only. Never put the FCRA credentials in these variables.
RAZORPAY_DOMESTIC_KEY_ID=rzp_live_TezfswPfz9JcMi
RAZORPAY_DOMESTIC_KEY_SECRET=

# Create this secret in Razorpay when the deployed webhook URL is available.
RAZORPAY_DOMESTIC_WEBHOOK_SECRET=

# Optional: caps a recurring instruction. Donors can still cancel earlier.
RAZORPAY_SUBSCRIPTION_MONTHLY_CYCLES=120
RAZORPAY_SUBSCRIPTION_YEARLY_CYCLES=10

# 80G receipts (see api/_receipt). Receipts are issued only when RECEIPTS_ENABLED=1 and the store and mailbox below are set.
RECEIPTS_ENABLED=1
# Counter store: Upstash Redis from the Vercel Marketplace sets KV_REST_API_URL and KV_REST_API_TOKEN (or UPSTASH_REDIS_REST_URL / _TOKEN).
RECEIPT_SMTP_HOST=smtp.gmail.com
RECEIPT_SMTP_PORT=465
RECEIPT_SMTP_USER=
RECEIPT_SMTP_PASS=
RECEIPT_FROM=
# Optional: RECEIPT_BCC (default finance@ and donate@dehatindia.org) and RECEIPT_REPLY_TO (default joinus@dehatindia.org).
